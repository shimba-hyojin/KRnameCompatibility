########################################################################
#  실제 환경변수 파일 (.gitignore에 등록되어 있음 — 절대 커밋하지 않는다)
#
#  로컬 실행:  docker compose --profile local --profile datadog up -d --build
#  운영 전환:  아래 "운영(RDS)" 주석 블록의 값으로 DB_HOST 등을 교체
########################################################################

# ---------------------------------------------------------------- App
APP_ENV=local                 # local | prod
LOG_LEVEL=INFO
PORT=8000
OWNER_NAME=심효진
OWNER_NAME_JA=シム・ヒョジン

# ---------------------------------------------------------------- Database
DB_ENABLED=true

# --- 로컬 (docker compose --profile local 의 mysql 컨테이너) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=namecompat
DB_USER=appuser
DB_PASSWORD=apppassword
MYSQL_ROOT_PASSWORD=rootpassword

# --- 운영(RDS)로 바꿀 때는 위 값을 아래처럼 교체 ---
# APP_ENV=prod
# DB_HOST=hyojin-db.c1mmuwo2mx97.ap-northeast-1.rds.amazonaws.com
# DB_USER=admin
# DB_PASSWORD=<RDS 마스터 암호>

# ---------------------------------------------------------------- Admin
# 랭킹 삭제 API 보호용. 비어 있으면 무인증 (SSH 터널 전용 환경 전제).
# 외부에 공개할 때는 반드시 값을 채운다.
ADMIN_TOKEN=

# ---------------------------------------------------------------- Fortune API
FORTUNE_API_URL=https://jugemkey.jp/api/waf/api.php
FORTUNE_API_KEY=Fortune
FORTUNE_TIMEOUT=3.0
FORTUNE_CACHE_TTL=600

# ---------------------------------------------------------------- Datadog
DD_API_KEY=
DD_SITE=datadoghq.com         # EU 조직이면 datadoghq.eu
DD_HOSTNAME=hyojin-ubuntu
DD_TRACE_ENABLED=false        # APM을 켤 때 true
